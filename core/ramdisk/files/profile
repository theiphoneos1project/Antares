export PATH="/bin:/sbin:/usr/bin:/usr/local/bin:/usr/sbin"

sleep 5

echo -ne "\x1b[H\x1b[J"

echo "========================================"   
echo
echo "        _\|/_ Antares Jailbreak         "
echo "        \"/|\\\" iPhone OS 1.0-1.1.5        "
echo "   By NightwindDev and EthanArbuckle    "   
echo
echo "========================================"   
echo

if [ "$(nvram antares_verbose_boot 2>/dev/null | cut -f 2)" == "1" ] ; then
	nvram boot-args="-v"
else
	nvram boot-args=""
fi

nvram auto-boot="true"

sleep 5

echo "[+] Checking disks..."
fsck_hfs -fy /dev/disk0s1 >/dev/null 2>&1
fsck_hfs -fy /dev/disk0s2 >/dev/null 2>&1

echo "[+] Mounting disks..."
mount_hfs -o noasync,sync /dev/disk0s1 /mnt1 >/dev/null 2>&1
mount_hfs -o noasync,sync /dev/disk0s2 /mnt2 >/dev/null 2>&1 

if [ ! -f "/mnt1/System/Library/CoreServices/SystemVersion.plist" ]; then
	echo "[!] Filesystem is not ready, waiting a bit longer..."
	sleep 5

	echo "[+] Checking disks..."
	fsck_hfs -fy /dev/disk0s1 >/dev/null 2>&1
	fsck_hfs -fy /dev/disk0s2 >/dev/null 2>&1

	echo "[+] Mounting disks..."
	mount_hfs -o noasync,sync /dev/disk0s1 /mnt1 >/dev/null 2>&1
	mount_hfs -o noasync,sync /dev/disk0s2 /mnt2 >/dev/null 2>&1 

	if [ ! -f "/mnt1/System/Library/CoreServices/SystemVersion.plist" ]; then
        echo "[-] Fatal Error: Failed to mount /dev/disk0s1. Rebooting..."
        sleep 5
        reboot
        exit 1
    fi
fi

if [ "$(nvram antares_jailbreak 2>/dev/null | cut -f 2)" == "1" ] ; then
	sh /tmp/jailbreak.sh
fi

if [ "$(nvram antares_hacktivate 2>/dev/null | cut -f 2)" == "1" ] ; then
	sh /tmp/hacktivate.sh
fi

echo "[+] Done setting up."

echo
echo "======================================="
echo "           !!! Attention !!!           "
echo "If you want to fully bootstrap your device, make sure to install the PXLdaemon and install the BSD base package."
echo "======================================="   
echo

sleep 10

nvram -d antares_verbose_boot >/dev/null
nvram -d antares_jailbreak >/dev/null
nvram -d antares_hacktivate >/dev/null

echo "[+] Rebooting..."
sleep 2
reboot