export PATH="/bin:/sbin:/usr/bin:/usr/local/bin:/usr/sbin"

/bin/sleep 5

/bin/echo -ne "\x1b[H\x1b[J"

/bin/echo "========================================"   
/bin/echo
/bin/echo "        _\|/_ Antares Jailbreak         "
/bin/echo "        \"/|\\\" iPhone OS 1.0-1.1.5        "
/bin/echo "   By NightwindDev and EthanArbuckle    "   
/bin/echo
/bin/echo "========================================"   
/bin/echo

/usr/bin/nvram boot-args="-v"
/usr/bin/nvram auto-boot="true"

/bin/sleep 5

/bin/echo "[+] Checking disks..."
/sbin/fsck_hfs -fy /dev/disk0s1 >/dev/null 2>&1
/sbin/fsck_hfs -fy /dev/disk0s2 >/dev/null 2>&1

/bin/echo "[+] Mounting disks..."
/sbin/mount_hfs -o noasync,sync /dev/disk0s1 /mnt1 >/dev/null 2>&1
/sbin/mount_hfs -o noasync,sync /dev/disk0s2 /mnt2 >/dev/null 2>&1 

if [ ! -f "/mnt1/System/Library/CoreServices/SystemVersion.plist" ]; then
	/bin/echo "[!] Filesystem is not ready, waiting a bit longer..."
	/bin/sleep 5

	/bin/echo "[+] Checking disks..."
	/sbin/fsck_hfs -fy /dev/disk0s1 >/dev/null 2>&1
	/sbin/fsck_hfs -fy /dev/disk0s2 >/dev/null 2>&1

	/bin/echo "[+] Mounting disks..."
	/sbin/mount_hfs -o noasync,sync /dev/disk0s1 /mnt1 >/dev/null 2>&1
	/sbin/mount_hfs -o noasync,sync /dev/disk0s2 /mnt2 >/dev/null 2>&1 

	if [ ! -f "/mnt1/System/Library/CoreServices/SystemVersion.plist" ]; then
        /bin/echo "[-] Fatal Error: Failed to mount /dev/disk0s1. Rebooting..."
        /bin/sleep 5
        /sbin/reboot
        exit 1
    fi
fi

/bin/echo "[+] Starting jailbreak..."

if ! /bin/grep -q "/dev/disk0s1 / hfs rw 0 1" /mnt1/etc/fstab; then
	/bin/echo "[+] Copying fstab to root filesystem..."
	/bin/cp /tmp/fstab /mnt1/etc/fstab
else
	/bin/echo "[+] The root filesystem is already mounted as read write. Skipping..."
fi

if [ ! -f /mnt1/bin/chmod ]; then
	/bin/echo "[+] Bootstrapping..."

	/bin/cp /bin/chmod /mnt1/bin/chmod
	/bin/cp /bin/sh /mnt1/bin/sh
	/bin/cp /tmp/ls /mnt1/bin/ls

	/bin/cp /usr/lib/libarmfp.dylib /mnt1/usr/lib/libarmfp.dylib
	/bin/cp /tmp/libintl.8.dylib /mnt1/usr/lib/libintl.8.dylib

	/bin/chmod +x /mnt1/bin/ls
else
	/bin/echo "[+] Device is already minimally bootstrapped. Skipping..."
fi

if ! /bin/grep -q "com.apple.afc2" /mnt1/System/Library/Lockdown/Services.plist; then
	/bin/echo "[+] Enabling Apple File Conduit \"2\"..."
	/bin/cp /tmp/Services.plist /mnt1/System/Library/Lockdown/Services.plist
else
	/bin/echo "[+] Apple File Conduit \"2\" is already enabled. Skipping..."
fi

/bin/sleep 5

/bin/echo "[+] Unmounting filesystems..."
/usr/bin/umount /mnt1 >/dev/null
/usr/bin/umount /mnt2 >/dev/null
/sbin/fsck_hfs /dev/disk0s1 >/dev/null
/sbin/fsck_hfs /dev/disk0s2 >/dev/null

/bin/echo "[+] Done setting up."

/bin/echo
/bin/echo "======================================="
/bin/echo "           !!! Attention !!!           "
/bin/echo "If you want to fully bootstrap your device, make sure to install the PXLdaemon and install the BSD base package."
/bin/echo "======================================="   
/bin/echo

/bin/sleep 10

/bin/echo "[+] Rebooting..."
/bin/sleep 2
/sbin/reboot